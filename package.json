{
  "name": "dos-play",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-static-routes.mjs && node scripts/build-edge.mjs",
    "build:site": "npm run build && node scripts/package-site-worker.mjs && node scripts/validate-site-artifact.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "build:edge": "node scripts/build-edge.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "gsap": "^3.15.0",
    "motion": "14.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.186.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  }
}
