# Copy to .env.local. Fill both public values, then rebuild the static site.
# Keep both blank to use labelled same-browser practice mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional private local images. Supply bytes outside Git, then restart/rebuild.
VITE_DAVINCI_BLACK_JOKER_IMAGE=
VITE_DAVINCI_WHITE_JOKER_IMAGE=
# Translation secrets are server-only. Never prefix them with VITE_.
