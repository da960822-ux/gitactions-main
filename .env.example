# docker compose --env-file .env 로 사용하거나, .env로 복사해서 사용하세요.

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=mooddb
MYSQL_USER=mooduser
MYSQL_PASSWORD=moodpass

# ---- Backend ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=mooddb
DB_USER=mooduser
DB_PASSWORD=moodpass
MODEL_BASE_URL=http://mood-model:8000
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ---- Frontend (dev) ----
VITE_API_PROXY_TARGET=http://backend:8080
